# Copia este archivo como .env y completa los valores. El .env nunca se sube al repo.

# Cadena de conexión de PostgreSQL tal como la entrega Neon (Dashboard -> Connect).
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
